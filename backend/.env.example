# --- Local Models ---
# You can use either model ids (from local HF cache) or explicit local folders.
# If outbound traffic is blocked, set EMBED_MODEL_PATH and CHAT_MODEL_PATH.

# --- Provider Selection ---
# local: use Hugging Face models loaded by transformers
# ollama: use Ollama local server
# lmstudio: use LM Studio OpenAI-compatible API
INFERENCE_PROVIDER=ollama
EMBEDDING_PROVIDER=local

# Embedding model id (default works for DistilBERT if available locally)
EMBED_MODEL=distilbert-base-uncased

# Optional explicit local folder for embedding model
# Example: F:/models/distilbert-base-uncased
EMBED_MODEL_PATH=

# Embedding vector dimension (distilbert-base-uncased = 768)
EMBED_DIM=768

# Chat model id
CHAT_MODEL=distilgpt2

# Optional explicit local folder for chat model
# Example: F:/models/distilgpt2
CHAT_MODEL_PATH=

# If true, backend may download missing model files from hf.co
# Keep false for strict offline mode.
ALLOW_MODEL_DOWNLOADS=false

# --- Ollama Local API ---
# Base URL for Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Required when INFERENCE_PROVIDER=ollama
OLLAMA_CHAT_MODEL=gpt-oss:20b

# Required when EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Request timeout for Ollama calls
OLLAMA_TIMEOUT_SECONDS=120

# --- LM Studio (OpenAI-compatible local API) ---
# Example base URL from LM Studio local server settings
LM_STUDIO_BASE_URL=http://127.0.0.1:1234

# Any non-empty key works for local LM Studio auth compatibility
LM_STUDIO_API_KEY=lm-studio

# Required when INFERENCE_PROVIDER=lmstudio
# Must match a loaded chat model identifier in LM Studio
LM_STUDIO_CHAT_MODEL=

# Required when EMBEDDING_PROVIDER=lmstudio
# Must match a loaded embedding model identifier in LM Studio
LM_STUDIO_EMBED_MODEL=

# Request timeout for LM Studio calls
LM_STUDIO_TIMEOUT_SECONDS=60
# --- CORS ---
# Comma-separated list of allowed frontend origins.
# In production, set this to your actual domain(s).
# Example: https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,null

# --- Cleanup ---
# Auto-delete conversations not updated in this many days. Set to 0 to disable.
CONVERSATION_RETENTION_DAYS=10

# --- RAG Retrieval ---
# Number of chunks fetched from the knowledge base per query.
# Higher = better recall but more context sent to the LLM. Default: 6
RAG_TOP_K=6

# Minimum cosine similarity required for a semantic FAISS hit.
RAG_MIN_SIMILARITY=0.08

# Minimum keyword-overlap ratio for hybrid retrieval fallback.
RAG_MIN_KEYWORD_SCORE=0.25

# Weight applied to keyword overlap when ranking candidate chunks.
RAG_KEYWORD_WEIGHT=0.20

# Number of keyword matches to consider before combining with FAISS results.
RAG_KEYWORD_TOP_K=8

# Chunk size and overlap used for newly uploaded documents.
# After changing these, clear the index and upload the document again.
RAG_CHUNK_SIZE=250
RAG_CHUNK_OVERLAP=50

# --- Multimodal RAG ---
# Set MULTIMODAL_ENABLED=true to unlock:
#   • Image extraction from PDFs (embedded rasters + page renders for scanned docs)
#   • Direct image file uploads (.png, .jpg, .jpeg, .gif, .bmp, .webp, .tiff)
#   • VLM-generated captions indexed as searchable text chunks
#   • Vision-aware Q&A: retrieved images are passed to the VLM alongside the query
MULTIMODAL_ENABLED=false

# VLM used for image captioning and visual Q&A via Ollama.
# Pull the model first:  ollama pull llava
# Recommended options:  llava | llava:13b | minicpm-v | qwen2-vl | bakllava
OLLAMA_VISION_MODEL=llava

# VLM model identifier in LM Studio (only when INFERENCE_PROVIDER=lmstudio).
# Leave empty to fall back to text-only for LM Studio.
LM_STUDIO_VISION_MODEL=

# Directory (relative to backend/) where extracted and uploaded images are persisted.
IMAGE_STORE_PATH=image_store

# Minimum pixel area (width × height) an extracted PDF image must have to be kept.
# Filters out tiny icons, bullets, and decorative elements. Default: 100×100 = 10 000 px².
IMAGE_MIN_AREA=10000

# JPEG quality (1–95) used when saving or encoding images.
IMAGE_JPEG_QUALITY=85

# Maximum long-edge (px) images are down-scaled to before being sent to the VLM API.
# Smaller = faster API calls; larger = more detail visible to the model. Default: 1024.
IMAGE_MAX_EDGE=1024

# Maximum number of embedded raster images to extract per PDF page.
# If a page has fewer embedded images than this, the full page is also rendered.
PDF_MAX_IMAGES_PER_PAGE=5

# Timeout (seconds) for VLM captioning and vision chat API calls.
# Increase for large images or slow hardware. Default: 180.
VISION_TIMEOUT_SECONDS=180
